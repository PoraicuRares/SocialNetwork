<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns = "http://javafx.com/javafx" xmlns:fx = "http://javafx.com/fxml"
            fx:controller="com.lab.controller.UserController">
    <padding><Insets top = "20" right = "20" left="20" bottom="20" /></padding>
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets bottom="12"/> </padding>
            <Label text ="Users"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="loginButton" text="Login as" onAction="#onLogin"/>
            <Button text="Add" onAction="#onAdd"/>
            <Button fx:id="editButton" text="Edit" onAction="#onEdit"/>
            <Button fx:id="deleteButton" text="Delete" onAction="#onDelete"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="userTable">
            <placeholder><Label text="There are no users"/> </placeholder>
            <columns>
                <TableColumn fx:id="idColumn" text ="Id" sortable="false"/>
                <TableColumn fx:id = "firstNameColumn" text="First name" sortable="false"/>
                <TableColumn fx:id="lastNameColumn" text="Last name" sortable="false"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top = "12"/></padding>
            <Button fx:id = "previousButton" text="Previous" onAction="#onPrevious"/>
            <Label fx:id="pageLabel"/>
            <Button fx:id = "nextButton" text ="Next" onAction="#onNext"/>
        </HBox>
    </bottom>
</BorderPane>
